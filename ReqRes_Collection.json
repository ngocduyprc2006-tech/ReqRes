          "name": "2. POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst responseJson = pm.response.json();\r\n\r\n// Kiểm tra dữ liệu khớp với file CSV\r\nconst expectedName = pm.iterationData.get(\"name\");\r\nconst expectedJob = pm.iterationData.get(\"job\");\r\n\r\nif (expectedName && expectedJob) {\r\n    pm.test(\"Name and job match CSV data\", function () {\r\n        pm.expect(responseJson.name).to.eql(expectedName);\r\n        pm.expect(responseJson.job).to.eql(expectedJob);\r\n    });\r\n}\r\n\r\n// Trích xuất id trả về và gán vào biến môi trường userId\r\npm.environment.set(\"userId\", responseJson.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"job\": \"{{job}}\"\r\n}",
