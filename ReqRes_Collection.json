          "name": "1. POST - Register User / Get Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst responseJson = pm.response.json();\r\npm.test(\"Token is returned and saved\", function () {\r\n    pm.expect(responseJson.token).to.exist;\r\n    pm.environment.set(\"userToken\", responseJson.token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"eve.holt@reqres.in\",\r\n    \"password\": \"pistol\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
