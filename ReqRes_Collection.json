									"pm.test(\"Status code is 201 or 200\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 200]);",
									"});",
									"",
									"const responseJson = pm.response.json();",
									"const expectedName = pm.iterationData.get(\"name\");",
									"const expectedJob = pm.iterationData.get(\"job\");",
									"",
									"if (expectedName && expectedJob) {",
									"    pm.test(\"Name and job match CSV data\", function () {",
									"        pm.expect(responseJson.name).to.eql(expectedName);",
									"        pm.expect(responseJson.job).to.eql(expectedJob);",
									"    });",
									"}",
									"",
									"pm.environment.set(\"userId\", responseJson.id);"
								]
